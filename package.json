{
  "name": "casse",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && node dist/serveur.cjs",
    "build": "node scripts/build.mjs --prod",
    "start": "node dist/serveur.cjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test packages/shared/test/regles.test.ts packages/shared/test/matrice.test.ts packages/shared/test/monde.test.ts packages/server/src/salon.test.ts",
    "simulation": "tsx scripts/simulation.ts",
    "lien": "node scripts/lien.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.21.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
